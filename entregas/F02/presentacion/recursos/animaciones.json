 "eq": {
  "eq_s2_cons": {
   "tex": "\\rho c_p \\frac{\\partial T}{\\partial t} = \\nabla\\cdot(k\\nabla T) + Q(a) - q_{frío}",
   "size": 20,
   "color": "202B33",
   "align": "left"
  },
  "eq_s2_dT": {
   "tex": "\\Delta T(t) = T_{max,\\Omega}(t) - T_{min,S25}(t)",
   "size": 23,
   "color": "743E99",
   "align": "left"
  },
  "eq_s4": {
   "tex": "C_i \\frac{d T_i}{d t} =\\sum_j G_{ij}(T_j - T_i) + Q_i + q_{borde} - q_{frío}",
   "size": 26,
   "color": "202B33",
   "align": "center"
  },
  "eq_s6_F": {
   "tex": "F_s = \\{T_{max} > 70\\} \\cup \\{\\Delta T_{max} > 20\\}",
   "size": 20,
   "color": "202B33",
   "align": "left"
  },
  "eq_s6_P": {
   "tex": "P_f = \\sum_s w_s I(F_s) = 0\\ \\%",
   "size": 22,
   "color": "166C65",
   "align": "left"
  },
  "eq_s7": {
   "tex": "D \\geq \\frac{V}{Q} = \\frac{636{,}775\\ \\mathrm{m}^3}{60\\ \\mathrm{m}^3/\\mathrm{h}} = 10{,}61\\ \\mathrm{h}",
   "size": 26,
   "color": "166C65",
   "align": "left"
  },
  "eq_b02_h": {
   "tex": "h(t) = 5{,}7 + 3{,}8\\, v_2(t)",
   "size": 26,
   "color": "202B33",
   "align": "left"
  },
  "eq_b02_v": {
   "tex": "v_2 = v_{10} \\left(\\frac{2}{10}\\right)^{0{,}14}",
   "size": 26,
   "color": "202B33",
   "align": "left"
  },
  "eq_b03_1": {
   "tex": "\\rho c_p \\frac{\\partial T}{\\partial t} = \\nabla\\cdot(k\\nabla T) + Q(a) - q_{frío}",
   "size": 28,
   "color": "202B33",
   "align": "left"
  },
  "eq_b03_2": {
   "tex": "-k\\frac{\\partial T}{\\partial n} = \\frac{T_s - T_{aire}}{R_{capas} + 1/h}",
   "size": 28,
   "color": "1B74AA",
   "align": "left"
  },
  "eq_b03_3": {
   "tex": "R_{suelo} = \\frac{0{,}50}{1{,}2} = 0{,}4167\\ \\mathrm{m}^2\\mathrm{K}/\\mathrm{W}",
   "size": 24,
   "color": "6E5A3A",
   "align": "left"
  },
  "eq_b06_1": {
   "tex": "q_{frío} = \\min\\left(\\sum_{c} U V_c \\max(T - 18, 0),\\ 15\\ \\mathrm{kW}\\right)",
   "size": 24,
   "color": "1B74AA",
   "align": "left"
  },
  "eq_b06_2": {
   "tex": "\\Delta T_{agua} = \\frac{P}{\\dot{m} c_{p,agua}} = \\frac{15\\,000}{2{,}7 \\cdot 4186} \\approx 1{,}33\\ \\mathrm{K}",
   "size": 24,
   "color": "202B33",
   "align": "left"
  },
  "eq_b08_1": {
   "tex": "C_i = \\rho c_p V_i \\qquad G_{ij} = \\frac{k A_{ij}}{\\Delta x}",
   "size": 24,
   "color": "202B33",
   "align": "left"
  },
  "eq_b08_2": {
   "tex": "T_i^{n+1} = T_i^n + \\frac{\\Delta t}{C_i}\\left[\\sum_j G_{ij}(T_j^n - T_i^n) + Q_i + q_b - q_f\\right]",
   "size": 21,
   "color": "202B33",
   "align": "left"
  },
  "eq_b08_3": {
   "tex": "\\Delta t \\leq 0{,}8\\, \\frac{C_i}{\\sum_j G_{ij}},\\quad \\Delta t \\leq 300\\ \\mathrm{s}",
   "size": 22,
   "color": "166C65",
   "align": "left"
  },
  "eq_b09": {
   "tex": "P_f = \\sum_{s=1}^{24} w_s\\, I(F_s), \\qquad w_s = \\frac{1}{24}",
   "size": 28,
   "color": "166C65",
   "align": "left"
  }
 },
